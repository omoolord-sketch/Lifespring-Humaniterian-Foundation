<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^api/admin/applications/([^/]+)/prepare-agreement$ /api/admin-prepare-agreement.php?applicationId=$1 [L,QSA]
  RewriteRule ^api/admin/agreements/([^/]+)/send$ /api/admin-send-agreement.php?agreementId=$1 [L,QSA]
  RewriteRule ^api/admin/agreements/([^/]+)/download$ /api/admin-download-agreement.php?agreementId=$1 [L,QSA]
  RewriteRule ^api/admin/agreements/([^/]+)/upload-signed$ /api/admin-upload-signed-agreement.php?agreementId=$1 [L,QSA]
  RewriteRule ^api/admin/agreements/([^/]+)/mark-signed$ /api/admin-mark-signed-agreement.php?agreementId=$1 [L,QSA]
  RewriteRule ^api/admin/agreements/([^/]+)/support-ready$ /api/admin-support-ready.php?agreementId=$1 [L,QSA]
  RewriteRule ^api/admin/agreements/([^/]+)/complete$ /api/admin-complete-agreement.php?agreementId=$1 [L,QSA]
  RewriteRule ^api/admin/applications$ /api/admin-applications.php [L,QSA]
  RewriteRule ^api/admin/import-legacy-application$ /api/admin-import-legacy-application.php [L,QSA]
  RewriteRule ^api/admin/application-status$ /api/admin-application-status.php [L,QSA]
  RewriteRule ^api/(scholarship|support-request|contact|donation-intent|complaints|report-a-concern)$ /api/$1.php [L,QSA]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

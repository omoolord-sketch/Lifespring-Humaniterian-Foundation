PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MAIL_FROM=noreply@lifespringhf.org
MAIL_TO=info@lifespringhf.org
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token

# Optional production SMTP settings. If omitted, the server uses an Ethereal test inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional frontend override. Development defaults to http://localhost:5000.
VITE_API_BASE_URL=http://localhost:5000

# Optional DocuSign eSignature API settings. Leave blank until the official
# DocuSign account, templates, Connect webhook, and private key are configured.
DOCUSIGN_ENVIRONMENT=development
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_PATH=
DOCUSIGN_AUTH_SERVER=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_WEBHOOK_SECRET=
DOCUSIGN_RETURN_URL=
DOCUSIGN_SCHOLARSHIP_TEMPLATE_NAME=LHF_SCHOLARSHIP_BENEFICIARY_AGREEMENT
DOCUSIGN_COMMUNITY_SUPPORT_TEMPLATE_NAME=LHF_COMMUNITY_SUPPORT_BENEFICIARY_AGREEMENT
